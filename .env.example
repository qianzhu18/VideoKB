SERVER_PORT=9090
SERVER_ADDRESS=127.0.0.1
DB_USERNAME=dovideo
# Fresh Compose installs create this account; keep it equal to DB_USERNAME.
MYSQL_APP_USER=dovideo
DB_PASSWORD=change-me
DB_URL='jdbc:mysql://localhost:3307/media_db?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf-8&allowPublicKeyRetrieval=true'
MYSQL_ROOT_PASSWORD=change-root-password
FLYWAY_BASELINE_ON_MIGRATE=true
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3.2
LLM_TIMEOUT_SECONDS=300
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0
AGENT_MAX_ESTIMATED_COST=0
AGENT_MAX_ROUNDS=2
# Must allow Planner, Executor and Critic to each use LLM_TIMEOUT_SECONDS once.
AGENT_MAX_DURATION_MS=900000
AGENT_MAX_ESTIMATED_TOKENS=50000
AGENT_EVALUATION_ENABLED=false
AI_INTERACTIVE_TIMEOUT_MS=180000
EMBEDDING_MODEL=BAAI/bge-m3
ASR_MODEL=XingChenAGI/XingChenASR-V3.2
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me
MINIO_ACCESS_KEY=dovideo
MINIO_SECRET_KEY=change-me-now
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=media
QDRANT_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=change-me-qdrant
QDRANT_COLLECTION=video_chunks
# Optional Milvus BM25 stage; backfill current sources before measuring/cutting lexical reads.
MILVUS_BM25_ENABLED=false
MILVUS_URL=http://localhost:19531
MILVUS_TOKEN=
MILVUS_BM25_COLLECTION=knowledge_bm25_v1
MILVUS_TIMEOUT_MS=5000
YTDLP_PATH=yt-dlp
MUKU_PATH=muku
# Keep batch manifests and Muku checkpoints on persistent local storage.
MUKU_WORK_DIR=./data/muku-batches
# 部分站点（如 B 站、YouTube）可能要求登录态才能下载在线视频链接。
# 仅在明确同意将浏览器登录态提供给本机下载器时设置；平台可能对账号限流或封禁。
# 二者互斥，YTDLP_COOKIES 优先；留空则不带 cookie（仅支持无需登录的站点）。
YTDLP_COOKIES=
YTDLP_COOKIES_FROM_BROWSER=
# 大型视频或源站限速时允许较长下载时间，默认 180 分钟。
YTDLP_TIMEOUT_MINUTES=180
FFMPEG_DIR=
OCR_COMMAND=tesseract
ROCKETMQ_NAME_SERVER=127.0.0.1:9876
VITE_API_BASE_URL=
VITE_DEV_PROXY_TARGET=http://localhost:9090
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Local directories the ingest scanner may read (comma-separated)
KNOWLEDGE_INGEST_ALLOWED_ROOTS=

# --- MCP adapter (dovideo-mcp-server, port 9091) ---
# Bearer tokens granted to MCP clients (the assistant side), comma-separated.
MCP_CLIENT_TOKENS=
# Upstream DoVideo API. Auth: either a reusable session token,
# or a service account with auto re-login (recommended for long-running deployments).
DOVIDEO_API_BASE=http://127.0.0.1:9090
DOVIDEO_API_TOKEN=
DOVIDEO_API_USERNAME=
DOVIDEO_API_PASSWORD=
# Audit trail location (JSONL, same design as knowledge_audit_logs).
MCP_AUDIT_PATH=data/mcp-audit.jsonl
