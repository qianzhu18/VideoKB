# dovideo 运行配置(复制为 .env 后填写)
# 核心 AI 能力走硅基流动(与原 DOVideo-AI 一致);不配置时自动进入离线 FakeLLM 演示模式
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3.2
LLM_TIMEOUT_SECONDS=300
EMBEDDING_MODEL=BAAI/bge-m3
ASR_MODEL=TeleAI/TeleSpeechASR

# Agent 预算三闸门(移植自原版)
AGENT_MAX_ROUNDS=2
AGENT_MAX_DURATION_MS=120000
AGENT_MAX_ESTIMATED_TOKENS=50000
AGENT_MAX_ESTIMATED_COST=0
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0

# 检索
MAX_CONTEXT_CHARS=24000
CHUNK_MS=300000
WINDOW_MS=60000
RETRIEVAL_TOP_K=3
MAX_USER_HITS=8

# 可选向量库(Qdrant 不可用自动降级本地余弦)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=video_chunks

# 存储(SQLite 真源 + 可选 Redis 热缓存)
DOVIDEO_DB_PATH=dovideo.db
REDIS_URL=

# 本机工具
FFMPEG_DIR=
OCR_COMMAND=tesseract

# 可选可观测(LangFuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
