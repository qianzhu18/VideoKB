# 腾讯服务器生产配置(复制为 .env 后填写)
# AI 能力:硅基流动(不配置则服务以离线 FakeLLM 模式运行,可先部署后补 Key)
SILICONFLOW_API_KEY=sk-replace-me
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3.2
EMBEDDING_MODEL=BAAI/bge-m3
ASR_MODEL=TeleAI/TeleSpeechASR

# 访问令牌:所有 API(除 /health)要求 Authorization: Bearer <token>
# 生成方式: openssl rand -hex 24(正式部署必须替换此占位值)
DOVIDEO_API_TOKEN=change-me-to-a-random-token

# Agent 预算(服务器可用默认值)
AGENT_MAX_ROUNDS=2
AGENT_MAX_DURATION_MS=120000
AGENT_MAX_ESTIMATED_TOKENS=50000
